#!/usr/bin/env sh
# Verify, then take stock.
#
# This is the one hook that should stop you: a red push is what turns into a
# broken deploy. Runs the project's real checks and blocks on failure.
#
# Never pushes, tags, or deploys.

set -u

APP="app"

if [ ! -f "$APP/package.json" ]; then
  echo "pre-push: no $APP/package.json yet, skipping checks."
  exit 0
fi

echo "pre-push: running checks in $APP/ ..."

run() {
  printf '  %-12s' "$1"
  if (cd "$APP" && pnpm run --silent "$1" >"${TMPDIR:-/tmp}/prepush.log" 2>&1); then
    echo "ok"
    return 0
  fi
  echo "FAILED"
  echo
  tail -30 "${TMPDIR:-/tmp}/prepush.log"
  echo
  echo "pre-push: '$1' failed. Push blocked." >&2
  echo "pre-push: fix it, or use --no-verify if you genuinely mean to push a red tree." >&2
  return 1
}

run lint      || exit 1
run typecheck || exit 1
run test      || exit 1

# Record the trail at the moment the tests actually ran, rather than
# reconstructing it later. Data only: the hook never writes Markdown.
if (cd "$APP" && pnpm run --silent trail >/dev/null 2>&1); then
  echo "  trail        recorded"
else
  echo "  trail        not recorded (no report, or no database yet)"
fi

# Take stock. Readiness is computed by /setup into .management/PROGRESS.md; the
# hook only echoes the current standing so it is visible at the moment of push.
PROGRESS=".management/PROGRESS.md"
if [ -f "$PROGRESS" ]; then
  echo
  grep -m1 -E '^\*\*Phase' "$PROGRESS" 2>/dev/null || true
  grep -m1 -E 'gates met' "$PROGRESS" 2>/dev/null || true
fi

echo
echo "pre-push: checks passed."
exit 0
